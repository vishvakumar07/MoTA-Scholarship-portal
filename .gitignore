# Local document storage — NEVER commit applicant documents
storage/documents/*
storage/processed/*
storage/temporary/*
storage/exports/*
# Keep directory structure tracked
!storage/documents/.gitkeep
!storage/processed/.gitkeep
!storage/temporary/.gitkeep
!storage/exports/.gitkeep

# Database
*.db
*.sqlite3
*.sqlite

# Docker override files (keep docker-compose.yml, ignore local overrides)
