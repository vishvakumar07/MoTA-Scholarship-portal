# =================================================================
# MoTA Scholarship System â€” Environment Configuration Template
# =================================================================
# Copy this file: cp .env.example .env
# Edit .env with your values before starting Docker Compose.
#
# TIER LEGEND:
#   [REQUIRED]        â€” Application will not start without this.
#   [OPTIONAL-AI]     â€” AI features unavailable without this; app still runs.
#   [OPTIONAL-STORAGE]â€” S3 storage; only needed if STORAGE_PROVIDER=s3.
#   [OPTIONAL-NOTIFY] â€” Email/SMS; in-app notifications work without this.
#   [OPTIONAL-GOVT]   â€” Government APIs; stubs used without this.
# =================================================================


# -----------------------------------------------------------------
# [REQUIRED] POSTGRES DATABASE
# -----------------------------------------------------------------
POSTGRES_PASSWORD=change_this_strong_password

# SQLAlchemy connection string (uses the above password)
DATABASE_URL=postgresql://mota_user:change_this_strong_password@postgres:5432/mota_scholarship

# Pool configuration
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10


# -----------------------------------------------------------------
# [REQUIRED] REDIS
# -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------
# [REQUIRED] JWT AUTHENTICATION
# -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_HEX_CHARS

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------
# [REQUIRED] FIELD-LEVEL ENCRYPTION
# Used for: bank account numbers (AES-256-GCM)
# Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# -----------------------------------------------------------------
FIELD_ENCRYPTION_KEY=CHANGE_THIS_TO_BASE64_ENCODED_32_BYTE_KEY


# -----------------------------------------------------------------
# [REQUIRED] APPLICATION SETTINGS
# -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------
# [REQUIRED] STORAGE CONFIGURATION
# STORAGE_PROVIDER=local uses local filesystem (default for SIH).
# No S3 credentials needed for local storage.
# -----------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_MB=10
MAX_DOCUMENTS_PER_APPLICATION=20


# -----------------------------------------------------------------
# [REQUIRED] MALWARE SCANNING (ClamAV via Docker)
# Application degrades gracefully if ClamAV is unavailable.
# -----------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310


# -----------------------------------------------------------------
# [OPTIONAL-AI] GOOGLE GEMINI (AI Provider)
# If not set: AI_PROVIDER defaults to "mock"
# MockAIService returns clearly labeled placeholder results.
# -----------------------------------------------------------------
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# GOOGLE_AI_API_KEY=


# -----------------------------------------------------------------
# [OPTIONAL-AI] GOOGLE CLOUD VISION (OCR)
# If not set: OCR_PROVIDER defaults to "unavailable"
# Manual document review remains possible.
# -----------------------------------------------------------------
OCR_PROVIDER=unavailable
# OCR_PROVIDER=google_vision
# GOOGLE_CLOUD_VISION_API_KEY=


# -----------------------------------------------------------------
# [OPTIONAL-STORAGE] S3-COMPATIBLE OBJECT STORAGE
# Only required when STORAGE_PROVIDER=s3
# Supports: AWS S3, MinIO, DigitalOcean Spaces, Cloudflare R2
# -----------------------------------------------------------------
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=mota-scholarship-documents
# S3_REGION=ap-south-1
# S3_PRESIGNED_URL_EXPIRE_SECONDS=900


# -----------------------------------------------------------------
# [OPTIONAL-NOTIFY] EMAIL (SMTP)
# If not set: email notifications are queued but not sent.
# In-app notifications work without SMTP.
# -----------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@mota-sih.local
# SMTP_FROM_NAME=MoTA Scholarship System
# SMTP_TLS=true


# -----------------------------------------------------------------
# [OPTIONAL-NOTIFY] SMS
# Not implemented for SIH prototype. Abstraction retained.
# -----------------------------------------------------------------
# SMS_GATEWAY_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=MOTASC


# -----------------------------------------------------------------
# [OPTIONAL-GOVT] GOVERNMENT API INTEGRATIONS
# All integrations use stubs by default.
# The UI clearly communicates integration status to users.
# Set to "live" only when authorized credentials are provided.
# -----------------------------------------------------------------
AADHAAR_INTEGRATION=stub
DIGILOCKER_INTEGRATION=stub
DBT_INTEGRATION=stub
NSP_INTEGRATION=stub
MOTA_DASHBOARD_INTEGRATION=stub

# Credentials for live integrations (only when authorized)
# AADHAAR_API_URL=
# AADHAAR_API_KEY=
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DBT_API_URL=
# DBT_API_KEY=
# NSP_API_URL=
# NSP_API_KEY=


# -----------------------------------------------------------------
# Frontend (Next.js) â€” set separately in apps/web/.env.local
# -----------------------------------------------------------------
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# -----------------------------------------------------------------
# [OPTIONAL-GOVT] PHASE 7 GOVERNMENT INTEGRATION ADAPTERS (EXPANDED)
# All integrations are DISABLED by default.
# Set to true ONLY when authorized credentials and API specifications
# are officially provided by the respective government authority.
# WARNING: Never commit real credentials to version control.
# -----------------------------------------------------------------

# UIDAI / Aadhaar
UIDAI_ENABLED=false
UIDAI_BASE_URL=
UIDAI_CLIENT_ID=
# UIDAI_CLIENT_SECRET=   <-- Backend-only; never expose to browser

# DigiLocker
DIGILOCKER_ENABLED=false
DIGILOCKER_BASE_URL=
DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=   <-- Backend-only; never expose to browser

# National Scholarship Portal
NSP_ENABLED=false
NSP_BASE_URL=
NSP_CLIENT_ID=
# NSP_CLIENT_SECRET=   <-- Backend-only; never expose to browser

# DBT / Tribal DBT
DBT_ENABLED=false
DBT_BASE_URL=
DBT_CLIENT_ID=
# DBT_CLIENT_SECRET=   <-- Backend-only; never expose to browser

# MoTA Dashboard / Ministry System
MOTA_ENABLED=false
MOTA_BASE_URL=
MOTA_CLIENT_ID=
# MOTA_CLIENT_SECRET=   <-- Backend-only; never expose to browser
