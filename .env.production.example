# ==============================================================================
# MoTA Scholarship & Fellowship Management System
# Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# DO NOT COMMIT THE ACTUAL .env.production FILE TO SOURCE CONTROL!
# Populate these values using institutional secret management (Vault / KMS / Docker Secrets).
# ==============================================================================

# --- Application Core ---
APP_ENV=production
DEBUG=False
PROJECT_NAME="MoTA Scholarship & Fellowship Management System"
API_V1_STR=/api/v1
SECRET_KEY=CHANGEME_GENERATE_A_64_CHAR_HEX_SECRET_FOR_FASTAPI
BACKEND_CORS_ORIGINS=["https://scholarships.mota.gov.in"]

# --- Database (PostgreSQL 16 + pgvector) ---
# Replace with sovereign institutional database cluster credentials
DATABASE_URL=postgresql+asyncpg://mota_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres-cluster.internal:5432/mota_scholarships
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Cache & Task Queue (Redis 7) ---
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis-cluster.internal:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# --- JWT Authentication & Session Security ---
JWT_SECRET_KEY=CHANGEME_GENERATE_A_64_CHAR_HEX_SECRET_FOR_JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.mota.gov.in

# --- Field-Level Data Encryption (PII & Bank Details) ---
# Must be a 32-url-safe base64-encoded key generated via: cryptography.fernet.Fernet.generate_key()
FIELD_ENCRYPTION_KEY=CHANGEME_FERNET_BASE64_KEY_DO_NOT_LOSE_THIS

# --- Document Storage Configuration ---
# Options: local, s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/var/data/mota/storage/uploads
# For S3-compatible sovereign object storage (if STORAGE_BACKEND=s3):
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# --- Antivirus Scanning (ClamAV Daemon) ---
CLAMAV_ENABLED=True
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# --- AI & Document Intelligence ---
# Mode options: GEMINI, LOCAL, MOCK, UNAVAILABLE
AI_SERVICE_MODE=MOCK
GEMINI_API_KEY=REQUIRES_AUTHORIZED_CONFIGURATION
AI_CONFIDENCE_THRESHOLD=0.75

# --- External Government Integration Adapters ---
# All integrations default to STUB mode until formal institutional authorization
UIDAI_INTEGRATION_MODE=STUB
UIDAI_API_ENDPOINT=REQUIRES_AUTHORIZED_CONFIGURATION
UIDAI_AUA_CODE=REQUIRES_AUTHORIZED_CONFIGURATION

DIGILOCKER_INTEGRATION_MODE=STUB
DIGILOCKER_API_ENDPOINT=REQUIRES_AUTHORIZED_CONFIGURATION
DIGILOCKER_CLIENT_ID=REQUIRES_AUTHORIZED_CONFIGURATION

NSP_INTEGRATION_MODE=STUB
NSP_API_ENDPOINT=REQUIRES_AUTHORIZED_CONFIGURATION

DBT_INTEGRATION_MODE=STUB
DBT_PFMS_API_ENDPOINT=REQUIRES_AUTHORIZED_CONFIGURATION

MOTA_CENTRAL_INTEGRATION_MODE=STUB
MOTA_API_ENDPOINT=REQUIRES_AUTHORIZED_CONFIGURATION

# --- Notification Dispatch (Email / SMS) ---
SMTP_ENABLED=False
SMTP_HOST=mail.mota.gov.in
SMTP_PORT=587
SMTP_USER=no-reply@mota.gov.in
SMTP_PASSWORD=REQUIRES_AUTHORIZED_CONFIGURATION
SMTP_FROM_EMAIL=no-reply@scholarships.mota.gov.in
SMTP_TLS=True

# --- Observability & Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
