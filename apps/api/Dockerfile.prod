# syntax=docker/dockerfile:1.7
# ============================================================
# MoTA Scholarship System — Production API Dockerfile
# Phase 13: Container hardening
# ============================================================
# Non-root user, minimal base, pinned versions, health check.
# Does NOT run --reload; uses gunicorn+uvicorn for production.
# ============================================================

FROM python:3.11.9-slim AS builder

# Install build deps in a separate layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip==24.0 \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir gunicorn==22.0.0

# ---- Final stage ----
FROM python:3.11.9-slim AS production

LABEL maintainer="MoTA Scholarship System"
LABEL description="FastAPI backend — production image"
LABEL org.opencontainers.image.title="mota-api"
LABEL org.opencontainers.image.version="1.0.0"

# Runtime system deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1001 mota \
    && useradd -u 1001 -g mota -s /bin/sh -m mota

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app

# Copy application source
COPY --chown=mota:mota . .

# Create storage directories; these will be overridden by volume mounts
RUN mkdir -p storage/documents storage/processed storage/temporary storage/exports \
    && chown -R mota:mota /app/storage

USER mota

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Production: gunicorn with uvicorn workers, no --reload
CMD ["gunicorn", "main:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--workers", "4", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--graceful-timeout", "30", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]
